{
  "name": "dao-dao-ui",
  "version": "2.7.1-rc.5",
  "scripts": {
    "build": "turbo run build --continue --filter=\"!@dao-dao/storybook\"",
    "build:no-apps": "turbo run build --continue --filter=\"!@dao-dao/storybook\" --filter=\"!@dao-dao/dapp\" --filter=\"!@dao-dao/sda\" --only",
    "dev": "pnpm dapp dev",
    "start": "pnpm dapp start",
    "format": "prettier --write \"**/*.{css,json,md}\" && turbo run format --continue --parallel",
    "lint": "turbo run lint --continue --parallel",
    "test": "vitest",
    "test:playwright": "pnpm tests test:playwright",
    "cwgen": "pnpm utils cwgen",
    "dapp": "pnpm --filter @dao-dao/dapp",
    "sda": "pnpm --filter @dao-dao/sda",
    "cfg": "pnpm --filter @dao-dao/config",
    "i18n": "pnpm --filter @dao-dao/i18n",
    "state": "pnpm --filter @dao-dao/state",
    "stateless": "pnpm --filter @dao-dao/stateless",
    "stateful": "pnpm --filter @dao-dao/stateful",
    "storybook": "pnpm --filter @dao-dao/storybook",
    "types": "pnpm --filter @dao-dao/types",
    "utils": "pnpm --filter @dao-dao/utils",
    "email": "pnpm --filter @dao-dao/email",
    "dispatch": "pnpm --filter @dao-dao/dispatch",
    "math": "pnpm --filter @dao-dao/math",
    "tests": "pnpm --filter @dao-dao/tests",
    "starship": "pnpm tests starship",
    "publish-all": "find . -name '*.log' -delete && find . -name '.turbo' -delete && find . -name '.DS_Store' -delete && lerna publish --no-private from-package"
  },
  "devDependencies": {
    "lerna": "^6.4.1",
    "prettier": "^3.4.2",
    "turbo": "^2.5.8",
    "turbo-ignore": "^2.5.8",
    "vitest": "^3.1.1"
  },
  "engines": {
    "npm": ">=7.0.0",
    "node": ">=14.0.0"
  },
  "prettier": "@dao-dao/config/prettier",
  "private": true,
  "packageManager": "pnpm@10.18.3+sha512.bbd16e6d7286fd7e01f6b3c0b3c932cda2965c06a908328f74663f10a9aea51f1129eea615134bf992831b009eabe167ecb7008b597f40ff9bc75946aadfb08d",
  "pnpm": {
    "overrides": {
      "@types/react": "^18.2.0",
      "@types/react-dom": "^18.2.0"
    },
    "patchedDependencies": {
      "@confio/relayer@0.12.0": "patches/@confio__relayer@0.12.0.patch",
      "@cosmjs/stargate@0.37.0": "patches/@cosmjs__stargate@0.37.0.patch",
      "@tanstack/query-core@5.83.1": "patches/@tanstack__query-core@5.83.1.patch",
      "@tanstack/query-devtools@5.83.1": "patches/@tanstack__query-devtools@5.83.1.patch",
      "@cosmjs/cosmwasm-stargate@0.37.0": "patches/@cosmjs__cosmwasm-stargate@0.37.0.patch"
    }
  }
}
